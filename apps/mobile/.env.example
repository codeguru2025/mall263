# Same meaning as web NEXT_PUBLIC_API_URL: origin only (no /api/v1 suffix, no trailing slash).
#
# Production (DigitalOcean — same host as the website; /api routes to Nest):
#   EXPO_PUBLIC_API_URL=https://mall263-r99jz.ondigitalocean.app
#
# Local backend only (emulator on same PC):
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Android emulator → host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=https://mall263-r99jz.ondigitalocean.app
