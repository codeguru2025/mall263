# Same meaning as web NEXT_PUBLIC_API_URL: origin only (no /api/v1 suffix, no trailing slash).
#
# Production (DigitalOcean — same host as the website; /api routes to Nest):
#   EXPO_PUBLIC_API_URL=https://mall263-r99jz.ondigitalocean.app
#
# Local backend only (emulator on same PC):
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Android emulator → host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=https://mall263-r99jz.ondigitalocean.app

# Sentry DSN for crash reporting (disabled in dev builds; get from sentry.io project settings).
# Also set as an EAS secret: eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value <dsn>
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/XXXXX

# Google Maps API key — required for Android AND iOS Google Maps tiles.
# Get from console.cloud.google.com → Maps SDK for Android/iOS → Credentials.
# Also set as an EAS secret: eas secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value <key>
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Map provider: 'google' uses Google Maps on both platforms (requires key above).
# Omit or set to anything else to use Apple Maps on iOS / default on Android.
EXPO_PUBLIC_MAP_PROVIDER=google

# Mapbox tokens (if switching to Mapbox in future)
# MAPBOX_DOWNLOADS_TOKEN=pk.eyJ1...
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.eyJ1...
