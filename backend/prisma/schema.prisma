generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  BUYER
  STALL_OWNER
  ATTENDANT
  FIELD_AGENT
  ADMIN_OPS
  FINANCE_ADMIN
  SUPPORT_ADMIN
  SUPER_ADMIN
  MALL_MANAGER
  DRIVER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum MerchantStatus {
  PENDING
  VERIFIED
  SUSPENDED
  DEACTIVATED
}

enum StallStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  SUSPENDED
  ARCHIVED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  COMMISSION_DEDUCTION
  COMMISSION_RESERVE
  BID_LOCK
  BID_UNLOCK
  BID_FORFEIT
  PURCHASE_DEBIT
  SALE_CREDIT
  REFUND_CREDIT
  REFUND_DEBIT
  FEE
  ADJUSTMENT
  // Delivery / escrow
  ESCROW_LOCK
  ESCROW_RELEASE
  ESCROW_REFUND
  DELIVERY_FEE
  DRIVER_EARNING
  RISK_RESERVE
  COD_COLLECTED
  COD_REMITTED
  FLOAT_HOLD
  FLOAT_RELEASE
  // Agent commissions
  AGENT_COMMISSION
  // Multi-shop run delivery
  RUN_ESCROW_LOCK
  RUN_ESCROW_RELEASE
  RUN_DRIVER_EARNING
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletLockReason {
  BID
  OFFER_ACCEPTANCE
  COMMISSION_HOLD
}

enum WalletLockStatus {
  ACTIVE
  RELEASED
  FORFEITED
  CONVERTED
}

enum DemandStatus {
  OPEN
  MATCHED
  FULFILLED
  CLOSED
  EXPIRED
  CANCELLED
}

enum DemandUrgency {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  COUNTERED
}

enum POSSaleStatus {
  PENDING
  COMPLETED
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  VOIDED
}

enum PaymentMethod {
  WALLET
  CASH
  ECOCASH
  ONEMONEY
  INNBUCKS
  BANK_TRANSFER
  MIXED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  BOGO // Buy One Get One
  BOGO_PERCENTAGE // Buy One Get X% Off Second
}

enum DiscountReason {
  PROMOTION
  LOYALTY
  BULK_PURCHASE
  SEASONAL
  CLEARANCE
  EMPLOYEE
  CUSTOMER_REQUEST
  DAMAGED_GOODS
  COMPETITOR_MATCH
}

enum NotificationType {
  DEMAND_MATCH
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  LOW_STOCK
  SALE_COMPLETED
  WALLET_FUNDED
  WALLET_LOW
  COMMISSION_LOW
  SYSTEM
  TRUST_UPDATE
  // Delivery
  JOB_BROADCAST
  JOB_ACCEPTED
  JOB_PICKUP_CONFIRMED
  JOB_DELIVERED
  JOB_CANCELLED
  COD_REMINDER
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  AGENT_COMMISSION_CREDITED
  // Multi-shop run delivery
  RUN_BID_RECEIVED
  RUN_BID_ACCEPTED
  RUN_LOCKED
  RUN_STOP_PICKED_UP
  RUN_DELIVERED
  RUN_COMPLETED
  RUN_CANCELLED
  RUN_COLLECTION_PROOF
  RUN_DELIVERY_PROOF
  DRIVER_DOC_VERIFIED
  DRIVER_DOC_REJECTED
  RUN_READY_FOR_COLLECTION
  RUN_COLLECTED
}

enum AgentTaskType {
  MERCHANT_ONBOARDING
  PRODUCT_CAPTURE
  QUALITY_REVIEW
  STALL_VERIFICATION
}

enum AgentTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SYNCING
}

enum ExpenseCategory {
  SALARY
  TRANSPORT
  MEALS
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  FEES
  TAXES
  OTHER
}

enum StallAnalyticsEventType {
  STORE_PAGE_VIEW
  PRODUCT_DETAIL_VIEW
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String     @unique
  phoneVerified Boolean    @default(false) @map("phone_verified")
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  avatarUrl     String?    @map("avatar_url")
  role          UserRole   @default(BUYER)
  status        UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt   DateTime?  @map("last_login_at")
  lastLoginIp   String?    @map("last_login_ip")
  pushToken     String?    @map("push_token")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  merchant       Merchant?
  wallet         Wallet?
  trustScore     TrustScore?
  buyerDemands   BuyerDemand[]
  notifications  Notification[]
  auditLogs      AuditLog[]       @relation("AuditUser")
  agentTasks     AgentTask[]      @relation("AgentTasks")
  attendantStall StallAttendant[]
  refreshTokens  RefreshToken[]
  sessions       Session[]
  chatMessages   ChatMessage[]    @relation("ChatMessages")
  subscription   Subscription?
  serviceListings      ServiceListing[]
  serviceRequests      ServiceRequest[]     @relation("ClientServiceRequests")
  serviceQuotes        ServiceQuote[]       @relation("ProviderServiceQuotes")
  serviceChatMessages  ServiceChatMessage[] @relation("ServiceChatSenders")
  recordedStallExpenses StallExpense[]      @relation("ExpenseRecordedBy")
  stallFollows          StallFollow[]
  supportRequestsSubmitted SupportRequest[] @relation("SupportRequestSubmitter")
  supportRequestsAssigned  SupportRequest[] @relation("SupportRequestAssignee")
  driver               Driver?
  sellerDeliveryJobs   DeliveryJob[]        @relation("SellerDeliveryJobs")
  buyerDeliveryJobs    DeliveryJob[]        @relation("BuyerDeliveryJobs")
  escrowAccounts       EscrowAccount[]      @relation("BuyerEscrow")
  buyerRuns            Run[]                @relation("BuyerRuns")
  buyerRunEscrows      RunEscrow[]          @relation("BuyerRunEscrows")
  disputesRaised       Dispute[]            @relation("DisputeRaisedBy")
  disputesResolved     Dispute[]            @relation("DisputeResolvedBy")
  agentCommissions     AgentCommission[]    @relation("AgentCommissions")
  productReviews       ProductReview[]
  addresses            UserAddress[]
  createdDiscounts      Discount[]           @relation("DiscountCreator")
  reviewedDocuments     DriverDocument[]     @relation("DocReviewer")
  usedQrTokens          RunQrToken[]         @relation("QrTokenUsedBy")
  collectedRuns         Run[]                @relation("CollectedRuns")

  @@index([phone])
  @@index([role])
  @@index([status])
  @@map("users")
}

model SupportRequest {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String?                @map("user_id") @db.Uuid
  contactName    String?                @map("contact_name")
  contactPhone   String?                @map("contact_phone")
  contactEmail   String?                @map("contact_email")
  topic          String
  message        String                 @db.Text
  status         SupportRequestStatus   @default(OPEN)
  adminNotes     String?                @map("admin_notes") @db.Text
  assignedToId   String?                @map("assigned_to_id") @db.Uuid
  resolvedAt     DateTime?              @map("resolved_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  user       User? @relation("SupportRequestSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("SupportRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_requests")
}

model RefreshToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  // Rotation family: every token issued in a single login/logout lifecycle shares
  // the same familyId. Detecting use of an already-revoked token in a family is
  // the classic "refresh-token reuse" attack, and we revoke the entire family.
  familyId     String   @default(uuid()) @map("family_id") @db.Uuid
  // The token that superseded this one (set at rotation time). Null means the
  // token is the current head of its family.
  replacedById String?  @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// MERCHANT & STALL
// ============================================================

model Merchant {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  businessName   String         @map("business_name")
  logoUrl        String?        @map("logo_url")
  businessPhone  String?        @map("business_phone")
  taxId          String?        @map("tax_id")
  status         MerchantStatus @default(PENDING)
  onboardedById  String?        @map("onboarded_by_id") @db.Uuid
  subscriptionTier String       @default("basic") @map("subscription_tier")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  verifiedAt     DateTime?      @map("verified_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stalls      Stall[]
  commissions AgentCommission[] @relation("AgentMerchantCommissions")

  @@index([status])
  @@index([onboardedById])
  @@map("merchants")
}

model Mall {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  cityId    String   @map("city_id") @db.Uuid
  address   String
  latitude  Float?
  longitude Float?
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city    City             @relation(fields: [cityId], references: [id])
  stalls Stall[]
  serviceListings ServiceListing[]
  buyerDemands BuyerDemand[]
  creationLogs MallCreationLog[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([isActive])
  @@map("malls")
}

model Stall {
  id            String      @id @default(uuid()) @db.Uuid
  merchantId    String      @map("merchant_id") @db.Uuid
  mallId        String?     @map("mall_id") @db.Uuid
  stallNumber   String      @map("stall_number")
  name          String
  floor         String?
  section       String?
  description   String?
  address       String?
  phone         String?
  openTime      String?     @map("open_time")
  closeTime     String?     @map("close_time")
  operatingDays String[]    @map("operating_days")
  latitude      Float?
  longitude     Float?
  imageUrl      String?     @map("image_url")
  logoUrl       String?     @map("logo_url")
  ecocashMerchantCode  String?     @map("ecocash_merchant_code")
  onemoneyMerchantCode String?     @map("onemoney_merchant_code")
  viewCount     Int         @default(0) @map("view_count")
  isPromoted    Boolean     @default(false) @map("is_promoted")
  promotedUntil DateTime?   @map("promoted_until")
  status        StallStatus @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  merchant      Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  mall          Mall?                 @relation(fields: [mallId], references: [id])
  shopSettings  ShopSettings?
  products      Product[]
  attendants    StallAttendant[]
  posSales      POSSale[]
  sellerOffers  SellerOffer[]         @relation("OfferStall")
  buyerDemands  BuyerDemand[]         @relation("DemandStall")
  serviceListings ServiceListing[]
  expenses          StallExpense[]
  analyticsEvents   StallAnalyticsEvent[]
  followers         StallFollow[]
  virtualWalkVideos ShopVirtualWalkVideo[]
  discounts         Discount[]
  runStops          RunStop[]                @relation("StallRunStops")

  @@unique([mallId, stallNumber])
  @@index([merchantId])
  @@index([mallId])
  @@index([status])
  @@index([isPromoted])
  @@map("stalls")
}

model StallAttendant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  stallId   String   @map("stall_id") @db.Uuid
  pin       String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stall Stall @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([userId, stallId])
  @@index([stallId])
  @@map("stall_attendants")
}

model StallFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  stallId   String   @map("stall_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stall Stall @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([userId, stallId])
  @@index([stallId])
  @@map("stall_follows")
}

// ============================================================
// PRODUCT & INVENTORY
// ============================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products        Product[]
  serviceListings ServiceListing[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// Local services offered by sellers (separate from physical product SKUs)
model ServiceListing {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  stallId     String?  @map("stall_id") @db.Uuid
  mallId      String?  @map("mall_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  title       String
  description String?
  priceFrom   Decimal? @map("price_from") @db.Decimal(12, 2)
  currency    String   @default("USD")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  stall    Stall?    @relation(fields: [stallId], references: [id])
  mall     Mall?     @relation(fields: [mallId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  requests ServiceRequest[]

  @@index([providerId])
  @@index([stallId])
  @@index([mallId])
  @@index([categoryId])
  @@index([isActive])
  @@map("service_listings")
}

// ============================================================
// SERVICE REQUEST / QUOTE / INVOICE FLOW
// ============================================================

enum ServiceRequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum ServiceQuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ServiceInvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model ServiceRequest {
  id         String               @id @default(uuid()) @db.Uuid
  listingId  String               @map("listing_id") @db.Uuid
  clientId   String               @map("client_id") @db.Uuid
  notes      String?
  budgetHint Decimal?             @map("budget_hint") @db.Decimal(12, 2)
  status     ServiceRequestStatus @default(OPEN)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  listing ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  client  User           @relation("ClientServiceRequests", fields: [clientId], references: [id])
  quotes  ServiceQuote[]

  @@index([listingId])
  @@index([clientId])
  @@index([status])
  @@map("service_requests")
}

model ServiceQuote {
  id            String             @id @default(uuid()) @db.Uuid
  requestId     String             @map("request_id") @db.Uuid
  providerId    String             @map("provider_id") @db.Uuid
  amount        Decimal            @db.Decimal(12, 2)
  description   String?
  estimatedDays Int?               @map("estimated_days")
  status        ServiceQuoteStatus @default(PENDING)
  respondedAt   DateTime?          @map("responded_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User            @relation("ProviderServiceQuotes", fields: [providerId], references: [id])
  invoice  ServiceInvoice?
  chatRoom ServiceChatRoom?

  @@index([requestId])
  @@index([providerId])
  @@index([status])
  @@map("service_quotes")
}

model ServiceInvoice {
  id            String               @id @default(uuid()) @db.Uuid
  quoteId       String               @unique @map("quote_id") @db.Uuid
  invoiceNumber String               @unique @map("invoice_number")
  data          Json
  totalAmount   Decimal              @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String               @default("CASH") @map("payment_method")
  status        ServiceInvoiceStatus @default(PENDING)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  quote ServiceQuote @relation(fields: [quoteId], references: [id])

  @@index([invoiceNumber])
  @@map("service_invoices")
}

model ServiceChatRoom {
  id        String   @id @default(uuid()) @db.Uuid
  quoteId   String   @unique @map("quote_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  quote    ServiceQuote       @relation(fields: [quoteId], references: [id])
  messages ServiceChatMessage[]

  @@map("service_chat_rooms")
}

model ServiceChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  room   ServiceChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User            @relation("ServiceChatSenders", fields: [senderId], references: [id])

  @@index([roomId])
  @@index([createdAt])
  @@map("service_chat_messages")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  stallId     String        @map("stall_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  brand       String?
  tags        String[]
  status      ProductStatus @default(ACTIVE)
  minPrice    Decimal       @map("min_price") @db.Decimal(12, 2)
  maxPrice    Decimal       @map("max_price") @db.Decimal(12, 2)
  currency    String        @default("USD")
  viewCount     Int           @default(0) @map("view_count")
  isPromoted    Boolean       @default(false) @map("is_promoted")
  promotedUntil DateTime?     @map("promoted_until")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  stall    Stall            @relation(fields: [stallId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  analyticsEvents StallAnalyticsEvent[]
  demands  BuyerDemand[]
  reviews  ProductReview[]
  videoHotspots VideoHotspot[]

  @@index([stallId])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([minPrice])
  @@index([createdAt])
  @@index([isPromoted])
  @@map("products")
}

model StallExpense {
  id           String          @id @default(uuid()) @db.Uuid
  stallId      String          @map("stall_id") @db.Uuid
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("USD")
  description  String?
  occurredAt   DateTime        @map("occurred_at")
  recordedById String?         @map("recorded_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  stall      Stall @relation(fields: [stallId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([stallId, occurredAt])
  @@index([category])
  @@map("stall_expenses")
}

model StallAnalyticsEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  stallId   String                  @map("stall_id") @db.Uuid
  type      StallAnalyticsEventType
  productId String?                 @map("product_id") @db.Uuid
  createdAt DateTime                @default(now()) @map("created_at")

  stall   Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([stallId, createdAt])
  @@index([stallId, type, createdAt])
  @@index([productId])
  @@map("stall_analytics_events")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String?
  barcode      String?
  name         String
  color        String?
  size         String?
  material     String?
  attributes   Json?
  costPrice    Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  currency     String   @default("USD")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory?
  posSaleItems  POSSaleItem[]
  offerVariants SellerOfferItem[]
  runStopItems  RunStopItem[]  @relation("RunStopItems")

  @@unique([sku])
  @@index([productId])
  @@index([barcode])
  @@index([sellingPrice])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

