generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  BUYER
  STALL_OWNER
  ATTENDANT
  FIELD_AGENT
  ADMIN_OPS
  FINANCE_ADMIN
  SUPPORT_ADMIN
  SUPER_ADMIN
  MALL_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum MerchantStatus {
  PENDING
  VERIFIED
  SUSPENDED
  DEACTIVATED
}

enum StallStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  SUSPENDED
  ARCHIVED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  COMMISSION_DEDUCTION
  COMMISSION_RESERVE
  BID_LOCK
  BID_UNLOCK
  BID_FORFEIT
  PURCHASE_DEBIT
  SALE_CREDIT
  REFUND_CREDIT
  REFUND_DEBIT
  FEE
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletLockReason {
  BID
  OFFER_ACCEPTANCE
  COMMISSION_HOLD
}

enum WalletLockStatus {
  ACTIVE
  RELEASED
  FORFEITED
  CONVERTED
}

enum DemandStatus {
  OPEN
  MATCHED
  CLOSED
  EXPIRED
  CANCELLED
}

enum DemandUrgency {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  COUNTERED
}

enum POSSaleStatus {
  PENDING
  COMPLETED
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  VOIDED
}

enum PaymentMethod {
  WALLET
  CASH
  ECOCASH
  INNBUCKS
  BANK_TRANSFER
  MIXED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum NotificationType {
  DEMAND_MATCH
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  LOW_STOCK
  SALE_COMPLETED
  WALLET_FUNDED
  WALLET_LOW
  COMMISSION_LOW
  SYSTEM
  TRUST_UPDATE
}

enum AgentTaskType {
  MERCHANT_ONBOARDING
  PRODUCT_CAPTURE
  QUALITY_REVIEW
  STALL_VERIFICATION
}

enum AgentTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SYNCING
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @unique
  phone         String     @unique
  phoneVerified Boolean    @default(false) @map("phone_verified")
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  avatarUrl     String?    @map("avatar_url")
  role          UserRole   @default(BUYER)
  status        UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt   DateTime?  @map("last_login_at")
  lastLoginIp   String?    @map("last_login_ip")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  merchant       Merchant?
  wallet         Wallet?
  trustScore     TrustScore?
  buyerDemands   BuyerDemand[]
  notifications  Notification[]
  auditLogs      AuditLog[]       @relation("AuditUser")
  agentTasks     AgentTask[]      @relation("AgentTasks")
  attendantStall StallAttendant[]
  refreshTokens  RefreshToken[]
  sessions       Session[]
  chatMessages   ChatMessage[]    @relation("ChatMessages")

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// MERCHANT & STALL
// ============================================================

model Merchant {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  businessName   String         @map("business_name")
  businessPhone  String?        @map("business_phone")
  businessEmail  String?        @map("business_email")
  taxId          String?        @map("tax_id")
  status         MerchantStatus @default(PENDING)
  onboardedById  String?        @map("onboarded_by_id") @db.Uuid
  subscriptionTier String       @default("basic") @map("subscription_tier")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  verifiedAt     DateTime?      @map("verified_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stalls Stall[]

  @@index([status])
  @@index([onboardedById])
  @@map("merchants")
}

model Mall {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  city      String
  address   String
  latitude  Float?
  longitude Float?
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stalls Stall[]

  @@index([city])
  @@map("malls")
}

model Stall {
  id            String      @id @default(uuid()) @db.Uuid
  merchantId    String      @map("merchant_id") @db.Uuid
  mallId        String?     @map("mall_id") @db.Uuid
  stallNumber   String      @map("stall_number")
  name          String
  floor         String?
  section       String?
  description   String?
  phone         String?
  openTime      String?     @map("open_time")
  closeTime     String?     @map("close_time")
  operatingDays String[]    @map("operating_days")
  latitude      Float?
  longitude     Float?
  imageUrl      String?     @map("image_url")
  status        StallStatus @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  merchant      Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  mall          Mall?            @relation(fields: [mallId], references: [id])
  products      Product[]
  attendants    StallAttendant[]
  posSales      POSSale[]
  sellerOffers  SellerOffer[]    @relation("OfferStall")

  @@unique([mallId, stallNumber])
  @@index([merchantId])
  @@index([mallId])
  @@index([status])
  @@map("stalls")
}

model StallAttendant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  stallId   String   @map("stall_id") @db.Uuid
  pin       String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stall Stall @relation(fields: [stallId], references: [id], onDelete: Cascade)

  @@unique([userId, stallId])
  @@index([stallId])
  @@map("stall_attendants")
}

// ============================================================
// PRODUCT & INVENTORY
// ============================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  stallId     String        @map("stall_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  brand       String?
  tags        String[]
  status      ProductStatus @default(ACTIVE)
  minPrice    Decimal       @map("min_price") @db.Decimal(12, 2)
  maxPrice    Decimal       @map("max_price") @db.Decimal(12, 2)
  currency    String        @default("USD")
  viewCount   Int           @default(0) @map("view_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  stall    Stall            @relation(fields: [stallId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([stallId])
  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@index([minPrice])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String?
  barcode      String?
  name         String
  color        String?
  size         String?
  material     String?
  attributes   Json?
  costPrice    Decimal  @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  currency     String   @default("USD")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory?
  posSaleItems  POSSaleItem[]
  offerVariants SellerOfferItem[]

  @@unique([sku])
  @@index([productId])
  @@index([barcode])
  @@index([sellingPrice])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id             String   @id @default(uuid()) @db.Uuid
  variantId      String   @unique @map("variant_id") @db.Uuid
  quantity       Int      @default(0)
  reservedQty    Int      @default(0) @map("reserved_qty")
  lowStockThreshold Int   @default(5) @map("low_stock_threshold")
  lastRestockedAt DateTime? @map("last_restocked_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustmentLogs   InventoryLog[]

  @@index([quantity])
  @@map("inventory")
}

model InventoryLog {
  id           String   @id @default(uuid()) @db.Uuid
  inventoryId  String   @map("inventory_id") @db.Uuid
  changeQty    Int      @map("change_qty")
  previousQty  Int      @map("previous_qty")
  newQty       Int      @map("new_qty")
  reason       String
  referenceId  String?  @map("reference_id")
  referenceType String? @map("reference_type")
  performedBy  String?  @map("performed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@map("inventory_logs")
}

// ============================================================
// WALLET & LEDGER
// ============================================================

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(14, 2)
  lockedBalance    Decimal  @default(0) @map("locked_balance") @db.Decimal(14, 2)
  currency         String   @default("USD")
  isActive         Boolean  @default(true) @map("is_active")
  lastActivityAt   DateTime? @map("last_activity_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  locks        WalletLock[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id              String                  @id @default(uuid()) @db.Uuid
  walletId        String                  @map("wallet_id") @db.Uuid
  type            WalletTransactionType
  amount          Decimal                 @db.Decimal(14, 2)
  balanceBefore   Decimal                 @map("balance_before") @db.Decimal(14, 2)
  balanceAfter    Decimal                 @map("balance_after") @db.Decimal(14, 2)
  status          WalletTransactionStatus @default(PENDING)
  description     String?
  referenceId     String?                 @map("reference_id")
  referenceType   String?                 @map("reference_type")
  counterpartyId  String?                 @map("counterparty_id") @db.Uuid
  externalRef     String?                 @map("external_ref")
  metadata        Json?
  createdAt       DateTime                @default(now()) @map("created_at")
  completedAt     DateTime?               @map("completed_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([referenceId])
  @@map("wallet_transactions")
}

model WalletLock {
  id         String           @id @default(uuid()) @db.Uuid
  walletId   String           @map("wallet_id") @db.Uuid
  amount     Decimal          @db.Decimal(14, 2)
  reason     WalletLockReason
  status     WalletLockStatus @default(ACTIVE)
  referenceId String          @map("reference_id")
  referenceType String        @map("reference_type")
  expiresAt  DateTime?        @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  releasedAt DateTime?        @map("released_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([referenceId])
  @@map("wallet_locks")
}

// ============================================================
// DEMAND & BIDDING
// ============================================================

model BuyerDemand {
  id          String        @id @default(uuid()) @db.Uuid
  buyerId     String        @map("buyer_id") @db.Uuid
  title       String
  description String?
  categoryId  String?       @map("category_id") @db.Uuid
  preferredSize    String?  @map("preferred_size")
  preferredColor   String?  @map("preferred_color")
  preferredBrand   String?  @map("preferred_brand")
  minBudget   Decimal?      @map("min_budget") @db.Decimal(12, 2)
  maxBudget   Decimal       @map("max_budget") @db.Decimal(12, 2)
  currency    String        @default("USD")
  urgency     DemandUrgency @default(MEDIUM)
  status      DemandStatus  @default(OPEN)
  mallId      String?       @map("mall_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  buyer  User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  offers SellerOffer[]

  @@index([buyerId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("buyer_demands")
}

model SellerOffer {
  id          String      @id @default(uuid()) @db.Uuid
  demandId    String      @map("demand_id") @db.Uuid
  stallId     String      @map("stall_id") @db.Uuid
  message     String?
  totalPrice  Decimal     @map("total_price") @db.Decimal(12, 2)
  currency    String      @default("USD")
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime    @map("expires_at")
  respondedAt DateTime?   @map("responded_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  demand          BuyerDemand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  stall           Stall            @relation("OfferStall", fields: [stallId], references: [id])
  items           SellerOfferItem[]
  chatRoom        ChatRoom?
  deliveryRequest DeliveryRequest?

  @@index([demandId])
  @@index([stallId])
  @@index([status])
  @@map("seller_offers")
}

model SellerOfferItem {
  id        String  @id @default(uuid()) @db.Uuid
  offerId   String  @map("offer_id") @db.Uuid
  variantId String  @map("variant_id") @db.Uuid
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)

  offer   SellerOffer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([offerId])
  @@map("seller_offer_items")
}

// ============================================================
// POS & SALES
// ============================================================

model POSSale {
  id             String        @id @default(uuid()) @db.Uuid
  stallId        String        @map("stall_id") @db.Uuid
  cashierId      String        @map("cashier_id") @db.Uuid
  receiptNumber  String        @unique @map("receipt_number")
  subtotal       Decimal       @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  discountType   String?       @map("discount_type")
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(14, 2)
  commissionAmount Decimal     @map("commission_amount") @db.Decimal(14, 2)
  commissionRate Decimal       @default(0.025) @map("commission_rate") @db.Decimal(5, 4)
  currency       String        @default("USD")
  paymentMethod  PaymentMethod @default(CASH)
  status         POSSaleStatus @default(COMPLETED)
  notes          String?
  customerPhone  String?       @map("customer_phone")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  stall   Stall         @relation(fields: [stallId], references: [id])
  items   POSSaleItem[]
  receipt Receipt?
  refunds Refund[]

  @@index([stallId])
  @@index([cashierId])
  @@index([receiptNumber])
  @@index([createdAt])
  @@index([status])
  @@map("pos_sales")
}

model POSSaleItem {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @map("sale_id") @db.Uuid
  variantId    String  @map("variant_id") @db.Uuid
  productName  String  @map("product_name")
  variantName  String  @map("variant_name")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice    Decimal @map("cost_price") @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(12, 2)

  sale    POSSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@map("pos_sale_items")
}

model Receipt {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @unique @map("sale_id") @db.Uuid
  data      Json
  sentTo    String?  @map("sent_to")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  sale POSSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  saleId       String       @map("sale_id") @db.Uuid
  amount       Decimal      @db.Decimal(14, 2)
  reason       String
  status       RefundStatus @default(REQUESTED)
  processedBy  String?      @map("processed_by") @db.Uuid
  processedAt  DateTime?    @map("processed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  sale POSSale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([status])
  @@map("refunds")
}

// ============================================================
// TRUST & SCORING
// ============================================================

model TrustScore {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  overallScore      Decimal  @default(50) @map("overall_score") @db.Decimal(5, 2)
  fundingScore      Decimal  @default(50) @map("funding_score") @db.Decimal(5, 2)
  completionScore   Decimal  @default(50) @map("completion_score") @db.Decimal(5, 2)
  cancellationScore Decimal  @default(50) @map("cancellation_score") @db.Decimal(5, 2)
  responseScore     Decimal  @default(50) @map("response_score") @db.Decimal(5, 2)
  accuracyScore     Decimal  @default(50) @map("accuracy_score") @db.Decimal(5, 2)
  totalTransactions Int      @default(0) @map("total_transactions")
  totalCancellations Int     @default(0) @map("total_cancellations")
  lastCalculatedAt  DateTime @default(now()) @map("last_calculated_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trust_scores")
}

// ============================================================
// FIELD AGENT
// ============================================================

model AgentTask {
  id          String          @id @default(uuid()) @db.Uuid
  agentId     String          @map("agent_id") @db.Uuid
  type        AgentTaskType
  status      AgentTaskStatus @default(PENDING)
  data        Json
  offlineId   String?         @unique @map("offline_id")
  syncedAt    DateTime?       @map("synced_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  agent User @relation("AgentTasks", fields: [agentId], references: [id])

  @@index([agentId])
  @@index([status])
  @@index([offlineId])
  @@map("agent_tasks")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// AUDIT & SECURITY
// ============================================================

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  entity       String
  entityId     String?  @map("entity_id")
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model FraudAlert {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  alertType   String   @map("alert_type")
  severity    String
  description String
  data        Json?
  isResolved  Boolean  @default(false) @map("is_resolved")
  resolvedBy  String?  @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([alertType])
  @@index([isResolved])
  @@index([createdAt])
  @@map("fraud_alerts")
}

// ============================================================
// CHAT
// ============================================================

model ChatRoom {
  id        String        @id @default(uuid()) @db.Uuid
  offerId   String        @unique @map("offer_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  offer    SellerOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("ChatMessages", fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ============================================================
// DELIVERY
// ============================================================

enum DeliveryStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model DeliveryRequest {
  id           String         @id @default(uuid()) @db.Uuid
  offerId      String         @unique @map("offer_id") @db.Uuid
  buyerAddress String?        @map("buyer_address")
  buyerLat     Float?         @map("buyer_lat")
  buyerLng     Float?         @map("buyer_lng")
  distanceKm   Float?         @map("distance_km")
  deliveryFee  Decimal?       @map("delivery_fee") @db.Decimal(10, 2)
  status       DeliveryStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  offer SellerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("delivery_requests")
}

// ============================================================
// APP SETTINGS
// ============================================================

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ============================================================
// MARKET PRICE TRACKING
// ============================================================

model MarketPrice {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  productName  String   @map("product_name")
  avgPrice     Decimal  @map("avg_price") @db.Decimal(12, 2)
  minPrice     Decimal  @map("min_price") @db.Decimal(12, 2)
  maxPrice     Decimal  @map("max_price") @db.Decimal(12, 2)
  sampleCount  Int      @map("sample_count")
  attributes   Json?
  currency     String   @default("USD")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@index([categoryId])
  @@index([productName])
  @@index([calculatedAt])
  @@map("market_prices")
}
