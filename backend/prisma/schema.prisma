  videoId    String   @map("video_id") @db.Uuid
  timestamp  Float    // in seconds from video start
  xCoord     Float    @map("x_coord") // normalized 0-1
  yCoord     Float    @map("y_coord") // normalized 0-1
  productId  String   @map("product_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  video   ShopVirtualWalkVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([productId])
  @@index([isActive])
  @@map("video_hotspots")
}

// ============================================================
// MALL CREATION DIAGNOSTICS
// ============================================================

model MallCreationLog {
  id          String   @id @default(uuid()) @db.Uuid
  mallId      String?  @map("mall_id") @db.Uuid
  payload     Json
  errorMessage String? @map("error_message")
  success     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  mall Mall? @relation(fields: [mallId], references: [id], onDelete: SetNull)

  @@index([mallId])
  @@index([success])
  @@index([createdAt])
  @@map("mall_creation_logs")
}
