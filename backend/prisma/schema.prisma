  @@index([offerId])
  @@map("delivery_requests")
}

// ============================================================
// DELIVERY NETWORK + DRIVER TRUST SYSTEM
// ============================================================

enum DriverTier {
  ONBOARDING // 0-30 days / <20 jobs; low COD exposure, small jobs
  TRUSTED    // 20-50 completed jobs, high remittance accuracy
  ELITE      // High-volume; priority dispatch; optional float top-up
}

enum DeliveryMode {
  SAFE_PAY        // Digital escrow; buyer funds locked until delivery confirmed
  CASH_ON_DELIVERY // Driver collects cash from buyer at doorstep
  DIRECT_DEAL     // Meet seller physically; no platform involvement
}

enum DeliveryJobStatus {
  BROADCAST        // Available to nearby drivers
  ACCEPTED         // Driver claimed the job
  PICKUP_CONFIRMED // Driver submitted pickup proof (photo + GPS)
  IN_TRANSIT       // En route to buyer
  DELIVERED        // Delivery proof submitted; awaiting confirmation
  COMPLETED        // Buyer confirmed or auto-confirmed after 24h
  CANCELLED
  RETURNED         // Item returned to seller
}

enum EscrowStatus {
  HELD                // Funds locked; awaiting delivery
  RELEASED_TO_SELLER  // Delivery confirmed; seller paid
  REFUNDED_TO_BUYER   // Return / dispute resolved in buyer's favour
  IN_DISPUTE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_SELLER  // Seller's favour; buyer pays
  RESOLVED_BUYER   // Buyer's favour; seller pays return cost
  RESOLVED_RESERVE // Ambiguous; system reserve absorbs cost
}

enum CODRemittanceStatus {
  PENDING  // Driver holding cash
  REMITTED // Cash handed in
  OVERDUE  // Exceeded remittance window
}

// Driver profile — extends User (role = DRIVER)
model Driver {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @unique @map("user_id") @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           DriverTier @default(ONBOARDING)
  isActive       Boolean    @default(true) @map("is_active")
  kycVerified    Boolean    @default(false) @map("kyc_verified")
  kycDocUrl      String?    @map("kyc_doc_url")
  vehicleType    String?    @map("vehicle_type")
  currentLat     Decimal?   @map("current_lat") @db.Decimal(10, 8)
  currentLng     Decimal?   @map("current_lng") @db.Decimal(11, 8)
  locationAt     DateTime?  @map("location_at")
  completedJobs  Int        @default(0) @map("completed_jobs")
  totalEarnings  Decimal    @default(0) @map("total_earnings") @db.Decimal(14, 2)
  floatBalance   Decimal    @default(0) @map("float_balance") @db.Decimal(14, 2)
  codCashHeld    Decimal    @default(0) @map("cod_cash_held") @db.Decimal(14, 2)
  maxCodExposure Decimal    @default(50) @map("max_cod_exposure") @db.Decimal(14, 2)
  rating         Decimal    @default(50) @db.Decimal(5, 2)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  jobs              DeliveryJob[]
  floatTransactions DriverFloatTransaction[]
  codTransactions   CODTransaction[]
  runs              Run[]
  runBids           RunBid[]                 @relation("DriverRunBids")
  documents         DriverDocument[]
  qrTokens          RunQrToken[]             @relation("DriverQrTokens")

  @@index([isActive, tier])
  @@index([currentLat, currentLng])
  @@map("drivers")
}

// Delivery job — the core logistics record
model DeliveryJob {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @map("order_id") @db.Uuid
  orderType String            @map("order_type") // "OFFER" | "POS_SALE"
  sellerId  String            @map("seller_id") @db.Uuid
  seller    User              @relation("SellerDeliveryJobs", fields: [sellerId], references: [id])
  buyerId   String            @map("buyer_id") @db.Uuid
  buyer     User              @relation("BuyerDeliveryJobs", fields: [buyerId], references: [id])
  driverId  String?           @map("driver_id") @db.Uuid
  driver    Driver?           @relation(fields: [driverId], references: [id])
  mode      DeliveryMode
  status    DeliveryJobStatus @default(BROADCAST)

  // Zones (always visible to all drivers)
  pickupZone String  @map("pickup_zone")
  dropZone   String  @map("drop_zone")

  // Full addresses — revealed only after driver accepts
  pickupAddress String? @map("pickup_address")
  dropAddress   String? @map("drop_address")
  pickupLat     Decimal? @map("pickup_lat") @db.Decimal(10, 8)
  pickupLng     Decimal? @map("pickup_lng") @db.Decimal(11, 8)
  dropLat       Decimal? @map("drop_lat") @db.Decimal(10, 8)
  dropLng       Decimal? @map("drop_lng") @db.Decimal(11, 8)
  distanceKm    Decimal? @map("distance_km") @db.Decimal(8, 2)

  // Financials
  itemAmount    Decimal @map("item_amount") @db.Decimal(14, 2)
  deliveryFee   Decimal @map("delivery_fee") @db.Decimal(14, 2)
  platformFee   Decimal @map("platform_fee") @db.Decimal(14, 2)
  reserveAmount Decimal @map("reserve_amount") @db.Decimal(14, 2)
  driverEarning Decimal @map("driver_earning") @db.Decimal(14, 2)

  // Pickup proof
  pickupPhotoUrl  String?  @map("pickup_photo_url")
  pickupTimestamp DateTime? @map("pickup_timestamp")
  pickupGpsLat    Decimal?  @map("pickup_gps_lat") @db.Decimal(10, 8)
  pickupGpsLng    Decimal?  @map("pickup_gps_lng") @db.Decimal(11, 8)

  // Delivery proof
  deliveryPhotoUrl  String?  @map("delivery_photo_url")
  deliveryTimestamp DateTime? @map("delivery_timestamp")
  deliveryGpsLat    Decimal?  @map("delivery_gps_lat") @db.Decimal(10, 8)
  deliveryGpsLng    Decimal?  @map("delivery_gps_lng") @db.Decimal(11, 8)

  broadcastedAt DateTime? @map("broadcasted_at")
  acceptedAt    DateTime? @map("accepted_at")
  completedAt   DateTime? @map("completed_at")
  cancelReason  String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  escrow         EscrowAccount?
  codTransaction CODTransaction?
  dispute        Dispute?

  @@index([status])
  @@index([sellerId])
  @@index([buyerId])
  @@index([driverId])
  @@index([mode, status])
  @@map("delivery_jobs")
}

// SafePay escrow — funds locked from buyer until delivery confirmed
model EscrowAccount {
  id          String       @id @default(uuid()) @db.Uuid
  jobId       String       @unique @map("job_id") @db.Uuid
  job         DeliveryJob  @relation(fields: [jobId], references: [id])
  buyerId     String       @map("buyer_id") @db.Uuid
  buyer       User         @relation("BuyerEscrow", fields: [buyerId], references: [id])
  totalHeld   Decimal      @map("total_held") @db.Decimal(14, 2)
  itemAmount  Decimal      @map("item_amount") @db.Decimal(14, 2)
  deliveryFee Decimal      @map("delivery_fee") @db.Decimal(14, 2)
  platformFee Decimal      @map("platform_fee") @db.Decimal(14, 2)
  reserveAmt  Decimal      @map("reserve_amt") @db.Decimal(14, 2)
  status      EscrowStatus @default(HELD)
  releasedAt  DateTime?    @map("released_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([buyerId, status])
  @@map("escrow_accounts")
}

// COD cash tracking — driver acts as cash collection agent
model CODTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  jobId            String              @unique @map("job_id") @db.Uuid
  job              DeliveryJob         @relation(fields: [jobId], references: [id])
  driverId         String              @map("driver_id") @db.Uuid
  driver           Driver              @relation(fields: [driverId], references: [id])
  cashAmount       Decimal             @map("cash_amount") @db.Decimal(14, 2)
  remittanceStatus CODRemittanceStatus @default(PENDING) @map("remittance_status")
  remittedAmount   Decimal             @default(0) @map("remitted_amount") @db.Decimal(14, 2)
  remittedAt       DateTime?           @map("remitted_at")
  remittanceRef    String?             @map("remittance_ref")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([driverId, remittanceStatus])
  @@map("cod_transactions")
}

// Driver float ledger — auto-held % of earnings as operational buffer
model DriverFloatTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  driver      Driver   @relation(fields: [driverId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  type        String   // HOLD | RELEASE | TOP_UP | DEDUCTION
  reference   String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([driverId])
  @@map("driver_float_transactions")
}

// Dispute — raised by buyer or seller after failed delivery
model Dispute {
  id         String        @id @default(uuid()) @db.Uuid
  jobId      String        @unique @map("job_id") @db.Uuid
  job        DeliveryJob   @relation(fields: [jobId], references: [id])
  raisedById String        @map("raised_by_id") @db.Uuid
  raisedBy   User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason     String
  evidence   Json?         // photo URLs, buyer/seller notes
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedById String?     @map("resolved_by_id") @db.Uuid
  resolvedBy   User?       @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?   @map("resolved_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([raisedById])
  @@map("disputes")
}

// System-level risk reserve pool
model RiskReservePool {
  id        String   @id @default(uuid()) @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  totalIn   Decimal  @default(0) @map("total_in") @db.Decimal(14, 2)
  totalOut  Decimal  @default(0) @map("total_out") @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("risk_reserve_pool")
}

// ============================================================
// MULTI-SHOP RUN DELIVERY
// ============================================================

enum RunStatus {
  OPEN              // Accepting driver bids
  LOCKED            // Buyer accepted a bid; escrow held
  IN_PROGRESS       // All stops picked up; driver en route to dropoff
  DELIVERED         // Driver submitted proof; awaiting buyer confirmation
  AT_PICKUP_POINT   // Delivered to pickup point; awaiting customer collection
  COMPLETED         // Buyer confirmed or 24h auto-confirm
  COLLECTED         // Customer collected from pickup point (terminal, like COMPLETED)
  CANCELLED
  DISPUTED
}

enum RunBidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RunStopStatus {
  PENDING    // Awaiting pickup
  PICKED_UP  // Driver confirmed pickup with PIN or QR scan
}

enum RunQrTokenType {
  PICKUP    // Driver→stall handoff: stall owner scans driver's QR
  DELIVERY  // Driver→buyer handoff: buyer scans driver's QR
}

enum DriverDocumentType {
  DRIVERS_LICENSE
  POLICE_CLEARANCE
  PROOF_OF_RESIDENCE
  CAR_REG_BOOK
  INSURANCE
  ZINARA
  NATIONAL_ID
}

enum DriverDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Multi-shop delivery run — buyer picks items from N stalls, one driver does all stops
model Run {
  id              String    @id @default(uuid()) @db.Uuid
  buyerId         String    @map("buyer_id") @db.Uuid
  buyer           User      @relation("BuyerRuns", fields: [buyerId], references: [id])
  driverId        String?   @map("driver_id") @db.Uuid
  driver          Driver?   @relation(fields: [driverId], references: [id])
  mode            DeliveryMode
  status          RunStatus @default(OPEN)

  // Drop-off (zone shown before lock; full address revealed to driver after lock)
  dropZone        String    @map("drop_zone")
  dropAddress     String?   @map("drop_address")
  dropLat         Decimal?  @map("drop_lat") @db.Decimal(10, 8)
  dropLng         Decimal?  @map("drop_lng") @db.Decimal(11, 8)

  // Route totals — computed at creation
  totalDistanceKm Decimal?  @map("total_distance_km") @db.Decimal(8, 2)
  suggestedFee    Decimal?  @map("suggested_fee") @db.Decimal(14, 2)
  maxBudget       Decimal?  @map("max_budget") @db.Decimal(14, 2)

  // Financials — set when bid accepted
  agreedFee       Decimal?  @map("agreed_fee") @db.Decimal(14, 2)
  platformFee     Decimal?  @map("platform_fee") @db.Decimal(14, 2)
  driverEarning   Decimal?  @map("driver_earning") @db.Decimal(14, 2)

  // Delivery proof (submitted by driver)
  deliveryPhotoUrl  String?   @map("delivery_photo_url")
  deliveryVideoUrl  String?   @map("delivery_video_url")
  deliveryTimestamp DateTime? @map("delivery_timestamp")
  deliveryGpsLat    Decimal?  @map("delivery_gps_lat") @db.Decimal(10, 8)
  deliveryGpsLng    Decimal?  @map("delivery_gps_lng") @db.Decimal(11, 8)

  // Pickup point delivery (optional alternative to home drop-off)
  pickupPointId    String?      @map("pickup_point_id") @db.Uuid
  pickupPoint      PickupPoint? @relation(fields: [pickupPointId], references: [id])
  collectionCode   String?      @map("collection_code")    // e.g. "SAM-4892" — shown to customer
  collectionToken  String?      @unique @map("collection_token") @db.Uuid  // UUID in QR code
  collectedAt      DateTime?    @map("collected_at")
  collectedById    String?      @map("collected_by_id") @db.Uuid
  collectedBy      User?        @relation("CollectedRuns", fields: [collectedById], references: [id])

  lockedAt     DateTime? @map("locked_at")
  completedAt  DateTime? @map("completed_at")
  cancelReason String?   @map("cancel_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  stops    RunStop[]
  bids     RunBid[]
  escrow   RunEscrow?
  qrTokens RunQrToken[]

  @@index([status])
  @@index([buyerId])
  @@index([driverId])
  @@index([mode, status])
  @@index([pickupPointId])
  @@map("runs")
}

// Named collection point — admin-managed; customers choose one as their delivery destination
model PickupPoint {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runs Run[]

  @@index([isActive])
  @@map("pickup_points")
}

// One pickup stop per stall within a run
model RunStop {
  id           String        @id @default(uuid()) @db.Uuid
  runId        String        @map("run_id") @db.Uuid
  run          Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  stallId      String        @map("stall_id") @db.Uuid
  stall        Stall         @relation("StallRunStops", fields: [stallId], references: [id])
  stopOrder    Int           @map("stop_order")
  status       RunStopStatus @default(PENDING)
  pickupPin    String        @map("pickup_pin")  // 4-digit, generated when run is LOCKED
  pickedUpAt   DateTime?     @map("picked_up_at")
  pickupGpsLat Decimal?      @map("pickup_gps_lat") @db.Decimal(10, 8)
  pickupGpsLng Decimal?      @map("pickup_gps_lng") @db.Decimal(11, 8)
  itemAmount         Decimal   @map("item_amount") @db.Decimal(14, 2)
  collectionPhotoUrl String?   @map("collection_photo_url")
  collectionVideoUrl String?   @map("collection_video_url")
  createdAt          DateTime  @default(now()) @map("created_at")

  items    RunStopItem[]
  qrTokens RunQrToken[]

  @@index([runId])
  @@index([stallId])
  @@map("run_stops")
}

// Individual items at each pickup stop
model RunStopItem {
  id        String         @id @default(uuid()) @db.Uuid
  stopId    String         @map("stop_id") @db.Uuid
  stop      RunStop        @relation(fields: [stopId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation("RunStopItems", fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @map("unit_price") @db.Decimal(12, 2)
  currency  String         @default("USD")

  @@index([stopId])
  @@map("run_stop_items")
}

// Driver's competitive bid on a run
model RunBid {
  id          String       @id @default(uuid()) @db.Uuid
  runId       String       @map("run_id") @db.Uuid
  run         Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  driverId    String       @map("driver_id") @db.Uuid
  driver      Driver       @relation("DriverRunBids", fields: [driverId], references: [id])
  fee         Decimal      @db.Decimal(14, 2)
  message     String?
  status      RunBidStatus @default(PENDING)
  respondedAt DateTime?    @map("responded_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([runId, driverId])
  @@index([runId, status])
  @@index([driverId])
  @@map("run_bids")
}

// Escrow for SAFE_PAY mode runs — funds locked until delivery confirmed
model RunEscrow {
  id          String       @id @default(uuid()) @db.Uuid
  runId       String       @unique @map("run_id") @db.Uuid
  run         Run          @relation(fields: [runId], references: [id])
  buyerId     String       @map("buyer_id") @db.Uuid
  buyer       User         @relation("BuyerRunEscrows", fields: [buyerId], references: [id])
  totalHeld   Decimal      @map("total_held") @db.Decimal(14, 2)
  itemAmount  Decimal      @map("item_amount") @db.Decimal(14, 2)
  deliveryFee Decimal      @map("delivery_fee") @db.Decimal(14, 2)
  platformFee Decimal      @map("platform_fee") @db.Decimal(14, 2)
  status      EscrowStatus @default(HELD)
  releasedAt  DateTime?    @map("released_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([buyerId])
  @@map("run_escrows")
}

// One-time QR token for driver→shop (PICKUP) and driver→buyer (DELIVERY) handoff
model RunQrToken {
  id        String         @id @default(uuid()) @db.Uuid
  token     String         @unique @default(uuid()) @db.Uuid
  type      RunQrTokenType
  runId     String         @map("run_id") @db.Uuid
  run       Run            @relation(fields: [runId], references: [id])
  stopId    String?        @map("stop_id") @db.Uuid
  stop      RunStop?       @relation(fields: [stopId], references: [id])
  driverId  String         @map("driver_id") @db.Uuid
  driver    Driver         @relation("DriverQrTokens", fields: [driverId], references: [id])
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  usedById  String?        @map("used_by_id") @db.Uuid
  usedBy    User?          @relation("QrTokenUsedBy", fields: [usedById], references: [id])
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([token])
  @@index([runId])
  @@index([driverId])
  @@map("run_qr_tokens")
}

// Driver onboarding KYC documents — all 7 must be APPROVED before driver is activated
model DriverDocument {
  id             String               @id @default(uuid()) @db.Uuid
  driverId       String               @map("driver_id") @db.Uuid
  driver         Driver               @relation(fields: [driverId], references: [id])
  type           DriverDocumentType
  fileUrl        String               @map("file_url")
  status         DriverDocumentStatus @default(PENDING_REVIEW)
  rejectedReason String?              @map("rejected_reason")
  reviewedById   String?              @map("reviewed_by_id") @db.Uuid
  reviewedBy     User?                @relation("DocReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?            @map("reviewed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([driverId, type])
  @@index([driverId])
  @@index([status])
  @@map("driver_documents")
}

