# Database (DigitalOcean Managed PostgreSQL)
DATABASE_URL=postgresql://doadmin:YOUR_DB_PASSWORD@your-db-host.db.ondigitalocean.com:25061/mall263?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7

# Redis / Valkey (DigitalOcean Managed — TLS required)
REDIS_HOST=your-redis-host.db.ondigitalocean.com
REDIS_PORT=25061
REDIS_PASSWORD=your_redis_password
REDIS_TLS=true

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
DO_SPACES_BUCKET=mall263-uploads
DO_SPACES_REGION=lon1
DO_SPACES_ACCESS_KEY=your_spaces_access_key
DO_SPACES_SECRET_KEY=your_spaces_secret_key
DO_SPACES_CDN_URL=https://mall263-uploads.lon1.cdn.digitaloceanspaces.com

# App
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# Superadmin seed (used by prisma/seed.ts — never commit real values)
SUPERADMIN_PHONE=+2637XXXXXXXXX
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=change_me_min_16_chars
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# Commission
COMMISSION_RATE=0.025

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=Mall263

# Paynow Zimbabwe Payment Gateway
# Register at https://www.paynow.co.zw/Account/Merchant — get Integration ID + Key
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
# The email address registered on the Paynow merchant account
PAYNOW_MERCHANT_EMAIL=your_paynow_registered_email@example.com
# Webhook URL — must be publicly accessible (your deployed backend URL)
PAYNOW_RESULT_URL=https://your-backend.ondigitalocean.app/api/v1/payments/webhook
# Where Paynow redirects the user after card payment
PAYNOW_RETURN_URL=https://your-frontend.ondigitalocean.app/wallet/deposit/return
