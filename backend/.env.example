# Database (local Docker or DigitalOcean Managed PostgreSQL)
DATABASE_URL="postgresql://mall263:password@localhost:5432/mall263?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7"

# Redis / Valkey (ioredis is wire-compatible — no code changes needed for Valkey)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false   # Set to true on DigitalOcean (Valkey/Redis managed clusters require TLS)

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-master-key"

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_BUCKET="mall263-uploads"
DO_SPACES_REGION="nyc3"
DO_SPACES_ACCESS_KEY=""
DO_SPACES_SECRET_KEY=""
DO_SPACES_CDN_URL="https://mall263-uploads.nyc3.cdn.digitaloceanspaces.com"

# App
PORT=4000
NODE_ENV="development"
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:3000"

# Commission
COMMISSION_RATE=0.025

# SMS (Africa's Talking)
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID="Mall263"
