# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mall263:password@localhost:5432/mall263?connection_limit=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ── DigitalOcean Spaces ───────────────────────────────────────────────────────
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
DO_SPACES_BUCKET=mall263-uploads
DO_SPACES_REGION=lon1
DO_SPACES_ACCESS_KEY=your_spaces_access_key
DO_SPACES_SECRET_KEY=your_spaces_secret_key
DO_SPACES_CDN_URL=https://mall263-uploads.lon1.cdn.digitaloceanspaces.com

# ── Paynow Zimbabwe (required for deposits) ───────────────────────────────────
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_MERCHANT_EMAIL=your_paynow_registered_email@example.com
PAYNOW_RESULT_URL=https://your-backend-domain.com/api/v1/payments/webhook
PAYNOW_RETURN_URL=https://your-frontend-domain.com/wallet/deposit/return

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1
COMMISSION_RATE=0.025
