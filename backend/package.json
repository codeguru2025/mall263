{
  "name": "mall263-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prisma-generate-safe.js",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').existsSync('dist/main.js') || (console.error('BUILD FAILED: dist/main.js not found'), process.exit(1))\"",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:pooled": "node scripts/prisma-migrate-deploy-pooled.mjs",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "echo \"No automated tests are defined yet\"",
    "test:e2e": "echo \"No E2E tests are defined yet\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^17.4.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "meilisearch": "^0.37.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "paynow": "^2.2.2",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.0"
