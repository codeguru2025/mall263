{
  "name": "mall263-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prisma-generate-safe.js",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').existsSync('dist/main.js') || (console.error('BUILD FAILED: dist/main.js not found'), process.exit(1))\"",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "echo \"No automated tests are defined yet\"",
    "test:e2e": "echo \"No E2E tests are defined yet\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.8.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^17.4.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "meilisearch": "^0.37.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "paynow": "^2.2.2",
    "prisma": "^5.8.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2",
    "uuid": "^9.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
